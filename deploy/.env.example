# 复制为 deploy/.env 后按实际环境修改; docker compose 会自动读取同目录下的 .env
# 示例为「无域名、公网 IP 直连、运营商封 80/443」场景(把 61.145.190.188 换成你的公网 IP)

# ---- 对外端口 ----
# 运营商封 80/443 入站时改为高位端口; 管理后台访问 http://<公网IP>:8000
NGINX_HTTP_PORT=8000
NGINX_HTTPS_PORT=8443

# ---- LiveKit ----
# 下发给手机端/PC 投屏端的 LiveKit 地址, 必须是客户端可达地址(无 TLS 用 ws://)
LIVEKIT_WS_URL=ws://61.145.190.188:7880
# (仅 Docker 部署) 服务端调用 LiveKit 管理 API 的地址, 留空则由 LIVEKIT_WS_URL 推导; Windows 原生部署脚本会自动用 127.0.0.1
# LIVEKIT_API_URL=
# 生产环境务必改掉, 并与 deploy/livekit/livekit.yaml 的 keys 保持一致
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-32
# LIVEKIT_IMAGE=livekit/livekit-server:v1.13.6

# ---- 后端 ----
MYSQL_ROOT_PASSWORD=root
APP_JWT_SECRET=ZG9vbS1tZWV0aW5nLXNlcnZlci1qd3Qtc2VjcmV0LWtleS0yMDI2LXZlcnktbG9uZw==
DEFAULT_ADMIN_USERNAME=jxys1
DEFAULT_ADMIN_PASSWORD=admin123
# 生产环境置为 true, 启动时拒绝上述默认密钥/密码
APP_REJECT_DEFAULT_SECRETS=false
# 管理后台的访问来源, 无域名时填 http://<公网IP>:<NGINX_HTTP_PORT>
APP_CORS_ALLOWED_ORIGINS=http://61.145.190.188:8000
